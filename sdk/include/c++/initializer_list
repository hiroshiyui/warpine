// <initializer_list> - Warpine's C++ runtime (ADR-0103): the layout both
// compilers build (a pointer to the elements and their count).
#ifndef WARPINE_CXX_INITIALIZER_LIST
#define WARPINE_CXX_INITIALIZER_LIST

#include <cstddef>

namespace std {

template <class E>
class initializer_list {
    const E *array_;
    size_t len_;
    constexpr initializer_list(const E *a, size_t n) noexcept : array_(a), len_(n) {}

public:
    typedef E value_type;
    typedef const E &reference;
    typedef const E &const_reference;
    typedef size_t size_type;
    typedef const E *iterator;
    typedef const E *const_iterator;

    constexpr initializer_list() noexcept : array_(nullptr), len_(0) {}
    constexpr size_t size() const noexcept { return len_; }
    constexpr const E *begin() const noexcept { return array_; }
    constexpr const E *end() const noexcept { return array_ + len_; }
};

template <class E> constexpr const E *begin(initializer_list<E> l) noexcept { return l.begin(); }
template <class E> constexpr const E *end(initializer_list<E> l) noexcept { return l.end(); }

} // namespace std

#endif
