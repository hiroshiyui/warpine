// Generated by `cargo run --bin gen_arch -- render` from doc/architecture/layers.toml and src/.
// Do not edit: change the layer map and render again.
digraph warpine {
  graph [rankdir=TB, fontname="Helvetica", fontsize=14, compound=true, newrank=true, nodesep=0.35, ranksep=0.5];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.15,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#455a64", fontcolor="#37474f"];
  subgraph cluster_guest {
    label="Guest: inside the KVM virtual machine (ADR-0003)"; style="rounded,filled"; fillcolor="#fff8e1"; color="#90a4ae";
    program [label="OS/2 program (LX / NE) and its DLLs", shape=component, fillcolor="#ffffff"];
    thunks [label="API stub area at MAGIC_API_BASE: INT 3 per ordinal (ADR-0005)", shape=component, fillcolor="#ffffff"];
  }
  subgraph cluster_host {
    label="Warpine host process (one per OS/2 process, ADR-0020)"; style="rounded,filled"; fillcolor="#e3f2fd"; color="#90a4ae";
    entry [label=<<B>Start-up: PM, VIO window, full screen or headless</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">main.rs, api.rs</FONT>>, fillcolor="#bbdefb"];
    formats [label=<<B>Executable formats</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">lx.rs, lx/header.rs, ne.rs, ne/header.rs</FONT>>, fillcolor="#bbdefb"];
    loading [label=<<B>Loading and guest memory: objects, fixups, GDT / IDT, imports, page tables (ADR-0088)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/lx_loader.rs, loader/ne_exec.rs, loader/descriptors.rs, loader/guest_mem.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/paging.rs</FONT>>, fillcolor="#bbdefb"];
    vcpu [label=<<B>vCPUs and threads: VM exits, kicks, callbacks, exceptions, signals (ADR-0007, ADR-0023)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/vm_backend.rs, loader/kvm_backend.rs, loader/vcpu.rs, loader/threads.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/critsec.rs, loader/exitlist.rs, loader/seh.rs, loader/signals.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/host_signal.rs, loader/interrupt.rs</FONT>>, fillcolor="#bbdefb"];
    dispatch [label=<<B>API dispatch: registry, sub-dispatchers, tracing</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/api_registry.rs, loader/api_dispatch.rs, loader/api_trace.rs, loader/api_ring.rs</FONT>>, fillcolor="#bbdefb"];
    core [label=<<B>Loader core: Loader, SharedState, managers, constants</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/mod.rs, loader/managers.rs, loader/mutex_ext.rs, loader/constants.rs</FONT>>, fillcolor="#bbdefb"];
    kernel [label=<<B>Kernel APIs: DOSCALLS, QUECALLS, MSG, processes and WinStartApp (nesting limit, ADR-0028), CONFIG.SYS THREADS= session limit, IPC, named pipes (ADR-0022), shared memory and semaphores across processes (ADR-0049, ADR-0050), timers, session clock and WARPINE.DLL 64-bit time (ADR-0039), 16-bit information segments (ADR-0040), the built-in CMD.EXE and its REXX, REXX.DLL / REXXAPI.DLL for programs (ADR-0077–0085)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/doscalls.rs, loader/dos_misc.rs, loader/stubs.rs, loader/process.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/exit_report.rs, loader/ipc.rs, loader/dostimer.rs, loader/modpath.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/suballoc.rs, loader/cmd.rs, loader/cmd/batch.rs, loader/cmd/builtins.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/cmd/env.rs, loader/cmd/external.rs, loader/cmd/files.rs, loader/cmd/prompt.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/cmd/rexx_host.rs, loader/rexx.rs, loader/rexx/builtins.rs, loader/rexx/condition.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/rexx/expr.rs, loader/rexx/interp.rs, loader/rexx/lexer.rs, loader/rexx/number.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/rexx/program.rs, loader/rexx/rexxutil.rs, loader/rexx/stream.rs, loader/rexx/template.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/rexx/trace.rs, loader/rexx/embed.rs, loader/rexx_vfs.rs, loader/rexxapi.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/rexxapi/host.rs, loader/cmd/input.rs, loader/cmd/parse.rs, loader/npipe.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/npipe_dir.rs, loader/npipe_api.rs, loader/npipe_sem.rs, loader/inherit.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/msgcalls.rs, loader/msgfile.rs, loader/pm_startapp.rs, loader/config_sys.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/session_threads.rs, loader/shared_arena.rs, loader/shared_sem.rs, loader/clock.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/warpine_api.rs, loader/infoseg.rs</FONT>>, fillcolor="#bbdefb"];
    nls [label=<<B>NLS and codepages: Unicode inside (ADR-0008, ADR-0016)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/codepage.rs, loader/locale.rs, loader/uconv.rs</FONT>>, fillcolor="#bbdefb"];
    vfs [label=<<B>Virtual file system: drives on host directories (ADR-0009)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/vfs.rs, loader/vfs_hostdir.rs, loader/file_attrs.rs</FONT>>, fillcolor="#bbdefb"];
    net_mm [label=<<B>Sockets and multimedia: SO32DLL / TCP32DLL, MMPM/2</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/tcpip.rs, loader/mmpm.rs</FONT>>, fillcolor="#bbdefb"];
    textmode [label=<<B>Text mode: VIOCALLS, KBDCALLS, MOUCALLS, ANSI console</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/console.rs, loader/ansi.rs, loader/viocalls.rs, loader/kbdcalls.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/moucalls.rs, loader/vio_frame.rs</FONT>>, fillcolor="#bbdefb"];
    pmwin [label=<<B>PM window manager: PMWIN windows, messages, hooks (ADR-0026), input, painting, presentation parameters, atoms, DDE, dialogs embedded in windows (ADR-0042)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_win.rs, loader/pm_types.rs, loader/pm_window.rs, loader/pm_winutil.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_track.rs, loader/track.rs, loader/pm_input.rs, loader/pm_dialog.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_msgbox.rs, loader/pm_destroy.rs, loader/pm_error.rs, loader/pm_pointer.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_minmax.rs, loader/pm_sysmenu.rs, loader/pm_paint.rs, loader/pm_query.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_keystate.rs, loader/pm_syscolor.rs, loader/pm_rect.rs, loader/pm_cursor.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_message.rs, loader/pm_hook.rs, loader/pm_frame.rs, loader/pm_accel.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_winmisc.rs, loader/pm_remote.rs, loader/pm_enum.rs, loader/pm_presparam.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_paint_style.rs, loader/pm_atom.rs, loader/pm_dde.rs</FONT>>, fillcolor="#bbdefb"];
    controls [label=<<B>Built-in controls: statics, buttons, entry fields, MLE, list box, scroll bar, combo box, spin button, slider, value set, notebook, container (records in guest memory, ADR-0043; sorting by chained guest calls, ADR-0044), drag and drop (ADR-0045; between programs, ADR-0057), owner draw (ADR-0025)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_controls.rs, loader/pm_button.rs, loader/pm_list.rs, loader/pm_edit.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_scrollbar.rs, loader/pm_combo.rs, loader/pm_spin.rs, loader/pm_owner.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_static.rs, loader/pm_notebook.rs, loader/pm_container.rs, loader/pm_drag.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_slider.rs, loader/pm_valueset.rs</FONT>>, fillcolor="#bbdefb"];
    gpi [label=<<B>GPI: presentation spaces, state, transforms, drawing, fonts, bitmaps, regions, clipping, paths (ADR-0024, ADR-0027)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_gpi.rs, loader/pm_bitmap.rs, loader/pm_shapes.rs, loader/pm_drawtext.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_region.rs, loader/pm_area.rs, loader/pm_text.rs, loader/pm_xform.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_coords.rs, loader/pm_psstate.rs</FONT>>, fillcolor="#bbdefb"];
    pmshell [label=<<B>PM shell DLLs: PMSHAPI profiles (ADR-0017), the switch list (the session's, ADR-0056), HELPMGR, the SOM runtime kernel (ADR-0059 to ADR-0063, ADR-0070 to ADR-0073)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pmshapi.rs, loader/profile.rs, loader/helpmgr.rs, loader/pm_switch.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/som.rs</FONT>>, fillcolor="#bbdefb"];
    stddlg [label=<<B>Standard dialogs and printing: PMCTLS file and font dialogs built in memory of built-in controls, PMSPL spooler and device escapes without printers (ADR-0029)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/pm_stddlg.rs, loader/pm_filedlg.rs, loader/pm_fontdlg.rs, loader/pmspl.rs</FONT>>, fillcolor="#bbdefb"];
    desktop [label=<<B>PM desktop front end: surfaces, compositor, chrome, fonts (ADR-0011, ADR-0012)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">gui/mod.rs, gui/renderer.rs, gui/sdl_renderer.rs, gui/sdl_renderer/compositor.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">gui/surface.rs, gui/region.rs, gui/damage.rs, gui/font.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">gui/glyph_transform.rs, gui/message.rs, gui/pointer.rs, gui/cursor.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">gui/popup_menu.rs, gui/system_menu.rs, gui/frame_track.rs, gui/frame_stats.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">gui/gui_script.rs, gui/headless.rs, gui/audio.rs, gui/sdl_renderer/compositor/remote.rs</FONT>>, fillcolor="#bbdefb"];
    desklink [label=<<B>Desktop link: frame pictures in sealed memfds, the desktop protocol and socket (ADR-0052)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">desktop/mod.rs, desktop/client.rs, desktop/proto.rs, desktop/transport.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">desktop/pixmap.rs, gui/desktop_events.rs</FONT>>, fillcolor="#bbdefb"];
    textdisplay [label=<<B>Text-mode display: VIO window and full-screen text (ADR-0013)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">gui/text_renderer.rs, gui/vio_window.rs, gui/vio_view.rs, gui/vio_switch.rs</FONT>>, fillcolor="#bbdefb"];
    debug [label=<<B>Debugging: GDB stub, crash dumps</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">loader/gdb_stub.rs, loader/crash_dump.rs</FONT>>, fillcolor="#bbdefb"];
  }
  subgraph cluster_server {
    label="Desktop server process (one per session, ADR-0052)"; style="rounded,filled"; fillcolor="#f5f5f5"; color="#90a4ae";
    deskserver [label=<<B>Desktop server: one SDL desktop per session, stacking, activation, input in order, window calls across programs, the session's shell services and drag strings (ADR-0052–0057)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">gui/desktop_server.rs, desktop/model.rs, desktop/calls.rs, desktop/services.rs</FONT>>, fillcolor="#e0e0e0"];
  }
  subgraph cluster_os {
    label="Host system"; style="rounded,filled"; fillcolor="#f5f5f5"; color="#90a4ae";
    kvm [label="Linux KVM (/dev/kvm)", shape=component, fillcolor="#ffffff"];
    sdl [label="SDL3: display, input, audio, clipboard (ADR-0010)", shape=component, fillcolor="#ffffff"];
    hostfs [label="Host file system: drive C: in $XDG_DATA_HOME/warpine/drive_c", shape=component, fillcolor="#ffffff"];
    network [label="Host network (Linux sockets)", shape=component, fillcolor="#ffffff"];
    children [label="Child Warpine processes (DosExecPgm, WinStartApp, pipes, signal exceptions)", shape=component, fillcolor="#ffffff"];
    gdb [label="GDB (remote protocol over TCP)", shape=component, fillcolor="#ffffff"];
  }
  subgraph cluster_build {
    label="Build tools (separate programs)"; style="rounded,filled"; fillcolor="#f1f8e9"; color="#90a4ae";
    tools [label=<<B>Build tools: lx-link, os2rc, os2msg, gen_api, gen_arch, gen_compat (ADR-0006, ADR-0015, ADR-0021, ADR-0033, ADR-0099, ADR-0105)</B><BR/><FONT POINT-SIZE="8" COLOR="#37474f">bin/lx_link.rs, bin/os2rc.rs, bin/os2msg.rs, bin/gen_api.rs</FONT><BR/><FONT POINT-SIZE="8" COLOR="#37474f">bin/gen_arch.rs, bin/gen_compat.rs</FONT>>, fillcolor="#dcedc8"];
  }
  { rank=min; program; thunks; }
  { rank=max; kvm; sdl; hostfs; network; children; gdb; }
  { rank=max; tools; }
  entry -> formats [label="parse"];
  entry -> loading [label="load"];
  loading -> program [label="map pages, apply fixups"];
  program -> thunks [label="call an import"];
  thunks -> vcpu [label="INT 3 → VM exit"];
  vcpu -> kvm [label="KVM_RUN"];
  vcpu -> dispatch [label="module + ordinal"];
  vcpu -> program [label="callbacks: window procedures, exception handlers, exit lists"];
  dispatch -> kernel;
  dispatch -> textmode;
  dispatch -> pmwin;
  dispatch -> gpi;
  dispatch -> pmshell;
  dispatch -> net_mm;
  kernel -> vfs;
  kernel -> nls;
  kernel -> children [label="DosExecPgm / WinStartApp (arguments, environment, inherited handles), named pipes"];
  vcpu -> children [label="signals and DosKillProcess as real-time signals (pidfd)"];
  pmshell -> vfs [label="profiles"];
  dispatch -> stddlg;
  stddlg -> controls [label="dialogs of built-in controls"];
  stddlg -> vfs [label="browse drives"];
  vfs -> hostfs;
  net_mm -> network;
  net_mm -> sdl [label="audio"];
  pmwin -> controls;
  pmwin -> gpi [label="paint"];
  controls -> gpi;
  gpi -> desktop [label="draw into frame surfaces"];
  desktop -> pmwin [label="input events, GUIMessage replies"];
  textmode -> textdisplay [label="VIO buffer (keys and mouse back)"];
  desktop -> sdl;
  textdisplay -> sdl;
  debug -> gdb;
  desktop -> desklink [label="frame pictures, input acknowledgements"];
  pmwin -> desklink [label="calls on other programs' windows"];
  desklink -> deskserver [label="socket in the session directory"];
  deskserver -> sdl [label="the session's desktop window and input"];
}
