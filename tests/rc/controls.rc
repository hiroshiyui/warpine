/* tests/rc/controls.rc - an os2rc input compared with Open Watcom's wrc -zm (ADR-0099). */
#define INCL_WIN
#define INCL_WINSTDSPIN
#define INCL_WINSTDSLIDER
#define INCL_WINSTDVALSET
#define INCL_WINSTDCNR
#define INCL_WINSTDBOOK
#include <os2.h>
DLGTEMPLATE 1
BEGIN
  DIALOG "D", 1, 1, 2, 3, 4
  BEGIN
    AUTOCHECKBOX "a", 10, 1,1,1,1
    AUTORADIOBUTTON "b", 11, 1,1,1,1
    CHECKBOX "c", 12, 1,1,1,1
    RADIOBUTTON "d", 13, 1,1,1,1
    PUSHBUTTON "e", 14, 1,1,1,1
    DEFPUSHBUTTON "f", 15, 1,1,1,1
    LTEXT "g", 16, 1,1,1,1
    CTEXT "h", 17, 1,1,1,1
    RTEXT "i", 18, 1,1,1,1
    GROUPBOX "j", 19, 1,1,1,1
    ENTRYFIELD "k", 20, 1,1,1,1
    LISTBOX 21, 1,1,1,1
    COMBOBOX "l", 22, 1,1,1,1
    MLE "m", 23, 1,1,1,1
    ICON 5, 24, 1,1,0,0
    SPINBUTTON 25, 1,1,1,1
    SLIDER 26, 1,1,1,1
    VALUESET 27, 1,1,1,1
    CONTAINER 28, 1,1,1,1
    NOTEBOOK 29, 1,1,1,1
  END
END
DLGTEMPLATE 2
BEGIN
  DIALOG "D", 2, 1, 2, 3, 4, WS_VISIBLE
  BEGIN
    AUTOCHECKBOX "a", 10, 1,1,1,1, WS_GROUP
    PUSHBUTTON "e", 14, 1,1,1,1, WS_GROUP
    LTEXT "g", 16, 1,1,1,1, DT_WORDBREAK
    ENTRYFIELD "k", 20, 1,1,1,1, ES_MARGIN
    LISTBOX 21, 1,1,1,1, LS_MULTIPLESEL
    COMBOBOX "l", 22, 1,1,1,1, CBS_DROPDOWNLIST
  END
END
