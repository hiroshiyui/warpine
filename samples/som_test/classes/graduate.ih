/*
 * graduate.ih - C implementation bindings of class GraduateStudent, written by hand for
 * Warpine as the SOM compiler would emit them (ADR-0059).
 */
#ifndef SOM_GraduateStudent_ih
#define SOM_GraduateStudent_ih

#include "graduate.h"

typedef struct GraduateStudentData {
    char thesis[128];
    char degree[16];
} GraduateStudentData;

SOMEXTERN struct GraduateStudentCClassDataStructure {
    SOMClass *parent;
    somDToken instanceDataToken;
} SOMDLINK GraduateStudentCClassData;

#define GraduateStudentGetData( somSelf ) \
    ((GraduateStudentData *)somDataResolve( (SOMObject *)(somSelf), GraduateStudentCClassData.instanceDataToken ))
#define GraduateStudentMethodDebug( c, m )  SOM_NoTrace( c, m )
#define _thesis  (somThis->thesis)
#define _degree  (somThis->degree)
/* The parent's printStudentInfo, whatever the object's class. */
#define GraduateStudent_parent_Student_printStudentInfo( somSelf ) \
    SOM_ClassResolve( GraduateStudentCClassData.parent, Student, printStudentInfo )( (Student *)(somSelf) )

SOM_Scope void   SOMLINK printStudentInfo( GraduateStudent *somSelf );
SOM_Scope char * SOMLINK getStudentType( GraduateStudent *somSelf );
SOM_Scope void   SOMLINK setUpGraduateStudent( GraduateStudent *somSelf, char *id, char *name, char *thesis, char *degree );

struct GraduateStudentClassDataStructure SOMDLINK GraduateStudentClassData;
struct GraduateStudentCClassDataStructure SOMDLINK GraduateStudentCClassData;

SOMClass * SOMLINK GraduateStudentNewClass( integer4 major, integer4 minor )
{
    SOMClass *cls;
    SOMClass *parent;

    if( GraduateStudentClassData.classObject ) return( GraduateStudentClassData.classObject );
    parent = StudentNewClass( 0, 0 );
    SOM_NEW_CLASS( cls, "GraduateStudent", parent, sizeof( GraduateStudentData ), 1, major, minor );
    SOM_OVERRIDE( cls, "printStudentInfo", printStudentInfo );
    SOM_OVERRIDE( cls, "getStudentType", getStudentType );
    GraduateStudentClassData.setUpGraduateStudent = SOM_ADD_METHOD( cls, "setUpGraduateStudent", setUpGraduateStudent );
    _somClassReady( cls );
    GraduateStudentCClassData.parent = parent;
    GraduateStudentCClassData.instanceDataToken = _somGetInstanceToken( cls );
    GraduateStudentClassData.classObject = cls;
    return( cls );
}

#endif
