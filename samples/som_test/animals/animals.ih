/*
 * animals.ih - C implementation bindings of module Animals, written by
 * hand for Warpine as the SOM compiler would emit them (ADR-0059,
 * ADR-0060).
 */
#ifndef SOM_Animals_ih
#define SOM_Animals_ih

#include "animals.h"

/* ---- Animals::M_Animal ---- */
typedef struct Animals_M_AnimalData {
    _IDL_SEQUENCE_Animals_Animal instances;
} Animals_M_AnimalData;
SOMEXTERN struct Animals_M_AnimalCClassDataStructure {
    SOMClass *parent;
    somDToken instanceDataToken;
} SOMDLINK Animals_M_AnimalCClassData;
#define Animals_M_AnimalGetData( somSelf ) \
    ((Animals_M_AnimalData *)somDataResolve( (SOMObject *)(somSelf), Animals_M_AnimalCClassData.instanceDataToken ))
#define _instances (somThis->instances)
#define Animals_M_AnimalMethodDebug( c, m ) SOM_MethodDebug( c, m )
#define Animals_M_Animal_parent_SOMClass_somNew( somSelf ) \
    SOM_ParentResolve( SOMClassClassData.classObject, SOMClass, somNew )( (SOMClass *)(somSelf) )
#define Animals_M_Animal_parent_SOMClass_somInit( somSelf ) \
    SOM_ParentResolve( SOMClassClassData.classObject, SOMObject, somInit )( (SOMObject *)(somSelf) )
#define Animals_M_Animal_parent_SOMClass_somUninit( somSelf ) \
    SOM_ParentResolve( SOMClassClassData.classObject, SOMObject, somUninit )( (SOMObject *)(somSelf) )
SOM_Scope _IDL_SEQUENCE_Animals_Animal SOMLINK ma__get_instances( Animals_M_Animal *somSelf, Environment *ev );
SOM_Scope void SOMLINK ma__set_instances( Animals_M_Animal *somSelf, Environment *ev, _IDL_SEQUENCE_Animals_Animal instances );
SOM_Scope Animals_Animal * SOMLINK ma_newAnimal( Animals_M_Animal *somSelf, Environment *ev, string name, string sound );
SOM_Scope void SOMLINK ma_addInstance( Animals_M_Animal *somSelf, Environment *ev, Animals_Animal *obj );
SOM_Scope void SOMLINK ma_deleteInstance( Animals_M_Animal *somSelf, Environment *ev, Animals_Animal *obj );
SOM_Scope SOMObject * SOMLINK ma_somNew( Animals_M_Animal *somSelf );
SOM_Scope void SOMLINK ma_somInit( Animals_M_Animal *somSelf );
SOM_Scope void SOMLINK ma_somUninit( Animals_M_Animal *somSelf );

/* ---- Animals::Animal ---- */
typedef struct Animals_AnimalData {
    string name;
    string sound;
    long nsound;
} Animals_AnimalData;
SOMEXTERN struct Animals_AnimalCClassDataStructure {
    SOMClass *parent;
    somDToken instanceDataToken;
} SOMDLINK Animals_AnimalCClassData;
#define Animals_AnimalGetData( somSelf ) \
    ((Animals_AnimalData *)somDataResolve( (SOMObject *)(somSelf), Animals_AnimalCClassData.instanceDataToken ))
#define _name (somThis->name)
#define _sound (somThis->sound)
#define _nsound (somThis->nsound)
#define Animals_AnimalMethodDebug( c, m ) SOM_MethodDebug( c, m )
#define Animals_Animal_parent_SOMObject_somFree( somSelf ) \
    SOM_ParentResolve( SOMObjectClassData.classObject, SOMObject, somFree )( (SOMObject *)(somSelf) )
#define Animals_Animal_parent_SOMObject_somInit( somSelf ) \
    SOM_ParentResolve( SOMObjectClassData.classObject, SOMObject, somInit )( (SOMObject *)(somSelf) )
#define Animals_Animal_parent_SOMObject_somUninit( somSelf ) \
    SOM_ParentResolve( SOMObjectClassData.classObject, SOMObject, somUninit )( (SOMObject *)(somSelf) )
#define Animals_Animal_parent_SOMObject_somDumpSelfInt( somSelf, level ) \
    SOM_ParentResolve( SOMObjectClassData.classObject, SOMObject, somDumpSelfInt )( (SOMObject *)(somSelf), (level) )
SOM_Scope string SOMLINK a__get_name( Animals_Animal *somSelf, Environment *ev );
SOM_Scope void SOMLINK a__set_name( Animals_Animal *somSelf, Environment *ev, string name );
SOM_Scope string SOMLINK a__get_sound( Animals_Animal *somSelf, Environment *ev );
SOM_Scope void SOMLINK a__set_sound( Animals_Animal *somSelf, Environment *ev, string sound );
SOM_Scope string SOMLINK a__get_genus( Animals_Animal *somSelf, Environment *ev );
SOM_Scope string SOMLINK a__get_species( Animals_Animal *somSelf, Environment *ev );
SOM_Scope void SOMLINK a_talk( Animals_Animal *somSelf, Environment *ev );
SOM_Scope void SOMLINK a_display( Animals_Animal *somSelf, Environment *ev );
SOM_Scope void SOMLINK a_somFree( Animals_Animal *somSelf );
SOM_Scope void SOMLINK a_somInit( Animals_Animal *somSelf );
SOM_Scope void SOMLINK a_somUninit( Animals_Animal *somSelf );
SOM_Scope void SOMLINK a_somDumpSelfInt( Animals_Animal *somSelf, long level );

