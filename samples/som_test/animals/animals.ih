/* ---- The attribute methods the compiler writes ---- */
SOM_Scope _IDL_SEQUENCE_Animals_Animal SOMLINK ma__get_instances( Animals_M_Animal *somSelf, Environment *ev )
{
    Animals_M_AnimalData *somThis = Animals_M_AnimalGetData( somSelf );
    return( somThis->instances );
}
SOM_Scope void SOMLINK ma__set_instances( Animals_M_Animal *somSelf, Environment *ev, _IDL_SEQUENCE_Animals_Animal instances )
{
    Animals_M_AnimalData *somThis = Animals_M_AnimalGetData( somSelf );
    somThis->instances = instances;
}
SOM_Scope string SOMLINK a__get_name( Animals_Animal *somSelf, Environment *ev )
{
    Animals_AnimalData *somThis = Animals_AnimalGetData( somSelf );
    return( somThis->name );
}
SOM_Scope string SOMLINK a__get_sound( Animals_Animal *somSelf, Environment *ev )
{
    Animals_AnimalData *somThis = Animals_AnimalGetData( somSelf );
    return( somThis->sound );
}
SOM_Scope string SOMLINK d__get_breed( Animals_Dog *somSelf, Environment *ev )
{
    Animals_DogData *somThis = Animals_DogGetData( somSelf );
    return( somThis->breed );
}
SOM_Scope string SOMLINK d__get_color( Animals_Dog *somSelf, Environment *ev )
{
    Animals_DogData *somThis = Animals_DogGetData( somSelf );
    return( somThis->color );
}

/* ---- The class data and the classes ---- */
struct Animals_M_AnimalClassDataStructure SOMDLINK Animals_M_AnimalClassData;
struct Animals_M_AnimalCClassDataStructure SOMDLINK Animals_M_AnimalCClassData;
struct Animals_AnimalClassDataStructure SOMDLINK Animals_AnimalClassData;
struct Animals_AnimalCClassDataStructure SOMDLINK Animals_AnimalCClassData;
struct Animals_KennelClassDataStructure SOMDLINK Animals_KennelClassData;
struct Animals_KennelCClassDataStructure SOMDLINK Animals_KennelCClassData;
struct Animals_DogClassDataStructure SOMDLINK Animals_DogClassData;
struct Animals_DogCClassDataStructure SOMDLINK Animals_DogCClassData;
struct Animals_BigDogClassDataStructure SOMDLINK Animals_BigDogClassData;
struct Animals_BigDogCClassDataStructure SOMDLINK Animals_BigDogCClassData;
struct Animals_LittleDogClassDataStructure SOMDLINK Animals_LittleDogClassData;
struct Animals_LittleDogCClassDataStructure SOMDLINK Animals_LittleDogCClassData;

SOMClass * SOMLINK Animals_M_AnimalNewClass( integer4 major, integer4 minor )
{
    SOMClass *cls;

    if( Animals_M_AnimalClassData.classObject ) return( Animals_M_AnimalClassData.classObject );
    SOM_NEW_META_CLASS( cls, "Animals::M_Animal", SOMClassClassData.classObject, (SOMClass *)0,
                        sizeof( Animals_M_AnimalData ), 5, major, minor );
    Animals_M_AnimalClassData._get_instances = SOM_ADD_METHOD( cls, "_get_instances", ma__get_instances );
    Animals_M_AnimalClassData._set_instances = SOM_ADD_METHOD( cls, "_set_instances", ma__set_instances );
    Animals_M_AnimalClassData.newAnimal = SOM_ADD_METHOD( cls, "newAnimal", ma_newAnimal );
    Animals_M_AnimalClassData.addInstance = SOM_ADD_METHOD( cls, "addInstance", ma_addInstance );
    Animals_M_AnimalClassData.deleteInstance = SOM_ADD_METHOD( cls, "deleteInstance", ma_deleteInstance );
    SOM_OVERRIDE( cls, "somNew", ma_somNew );
    SOM_OVERRIDE( cls, "somInit", ma_somInit );
    SOM_OVERRIDE( cls, "somUninit", ma_somUninit );
    _somClassReady( cls );
    Animals_M_AnimalCClassData.parent = SOMClassClassData.classObject;
    Animals_M_AnimalCClassData.instanceDataToken = _somGetInstanceToken( cls );
    Animals_M_AnimalClassData.classObject = cls;
    return( cls );
}

SOMClass * SOMLINK Animals_AnimalNewClass( integer4 major, integer4 minor )
{
    SOMClass *cls;

    if( Animals_AnimalClassData.classObject ) return( Animals_AnimalClassData.classObject );
    Animals_M_AnimalNewClass( Animals_M_Animal_MajorVersion, Animals_M_Animal_MinorVersion );
    SOM_NEW_META_CLASS( cls, "Animals::Animal", SOMObjectClassData.classObject, Animals_M_AnimalClassData.classObject,
                        sizeof( Animals_AnimalData ), 8, major, minor );
    Animals_AnimalClassData._get_name = SOM_ADD_METHOD( cls, "_get_name", a__get_name );
    Animals_AnimalClassData._set_name = SOM_ADD_METHOD( cls, "_set_name", a__set_name );
    Animals_AnimalClassData._get_sound = SOM_ADD_METHOD( cls, "_get_sound", a__get_sound );
    Animals_AnimalClassData._set_sound = SOM_ADD_METHOD( cls, "_set_sound", a__set_sound );
    Animals_AnimalClassData._get_genus = SOM_ADD_METHOD( cls, "_get_genus", a__get_genus );
    Animals_AnimalClassData._get_species = SOM_ADD_METHOD( cls, "_get_species", a__get_species );
    Animals_AnimalClassData.talk = SOM_ADD_METHOD( cls, "talk", a_talk );
    Animals_AnimalClassData.display = SOM_ADD_METHOD( cls, "display", a_display );
    SOM_OVERRIDE( cls, "somFree", a_somFree );
    SOM_OVERRIDE( cls, "somInit", a_somInit );
    SOM_OVERRIDE( cls, "somUninit", a_somUninit );
    SOM_OVERRIDE( cls, "somDumpSelfInt", a_somDumpSelfInt );
    _somClassReady( cls );
    Animals_AnimalCClassData.parent = SOMObjectClassData.classObject;
    Animals_AnimalCClassData.instanceDataToken = _somGetInstanceToken( cls );
    Animals_AnimalClassData.classObject = cls;
    return( cls );
}

SOMClass * SOMLINK Animals_KennelNewClass( integer4 major, integer4 minor )
{
    SOMClass *cls;

    if( Animals_KennelClassData.classObject ) return( Animals_KennelClassData.classObject );
    SOM_NEW_META_CLASS( cls, "Animals::Kennel", SOMClassClassData.classObject, (SOMClass *)0,
                        sizeof( Animals_KennelData ), 1, major, minor );
    Animals_KennelClassData.newDog = SOM_ADD_METHOD( cls, "newDog", md_newDog );
    SOM_OVERRIDE( cls, "somNew", md_somNew );
    _somClassReady( cls );
    Animals_KennelCClassData.parent = SOMClassClassData.classObject;
    Animals_KennelCClassData.instanceDataToken = _somGetInstanceToken( cls );
    Animals_KennelClassData.classObject = cls;
    return( cls );
}

SOMClass * SOMLINK Animals_DogNewClass( integer4 major, integer4 minor )
{
    SOMClass *cls;

    if( Animals_DogClassData.classObject ) return( Animals_DogClassData.classObject );
    Animals_AnimalNewClass( Animals_Animal_MajorVersion, Animals_Animal_MinorVersion );
    Animals_KennelNewClass( Animals_Kennel_MajorVersion, Animals_Kennel_MinorVersion );
    SOM_NEW_META_CLASS( cls, "Animals::Dog", Animals_AnimalClassData.classObject, Animals_KennelClassData.classObject,
                        sizeof( Animals_DogData ), 4, major, minor );
    Animals_DogClassData._get_breed = SOM_ADD_METHOD( cls, "_get_breed", d__get_breed );
    Animals_DogClassData._set_breed = SOM_ADD_METHOD( cls, "_set_breed", d__set_breed );
    Animals_DogClassData._get_color = SOM_ADD_METHOD( cls, "_get_color", d__get_color );
    Animals_DogClassData._set_color = SOM_ADD_METHOD( cls, "_set_color", d__set_color );
    SOM_OVERRIDE( cls, "_get_genus", d__get_genus );
    SOM_OVERRIDE( cls, "_get_species", d__get_species );
    SOM_OVERRIDE( cls, "display", d_display );
    SOM_OVERRIDE( cls, "somInit", d_somInit );
    SOM_OVERRIDE( cls, "somUninit", d_somUninit );
    SOM_OVERRIDE( cls, "somDumpSelfInt", d_somDumpSelfInt );
    _somClassReady( cls );
    Animals_DogCClassData.parent = Animals_AnimalClassData.classObject;
    Animals_DogCClassData.instanceDataToken = _somGetInstanceToken( cls );
    Animals_DogClassData.classObject = cls;
    return( cls );
}

SOMClass * SOMLINK Animals_BigDogNewClass( integer4 major, integer4 minor )
{
    SOMClass *cls;

    if( Animals_BigDogClassData.classObject ) return( Animals_BigDogClassData.classObject );
    Animals_DogNewClass( Animals_Dog_MajorVersion, Animals_Dog_MinorVersion );
