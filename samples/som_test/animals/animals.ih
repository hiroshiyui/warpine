                        0, 0, major, minor );
    SOM_OVERRIDE( cls, "talk", bd_talk );
    _somClassReady( cls );
    Animals_BigDogCClassData.parent = Animals_DogClassData.classObject;
    Animals_BigDogCClassData.instanceDataToken = _somGetInstanceToken( cls );
    Animals_BigDogClassData.classObject = cls;
    return( cls );
}

