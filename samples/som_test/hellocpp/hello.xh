/*
 * hello.xh - C++ usage bindings of class Hello (hello.idl of the Open
 * Watcom SOM samples), written by hand for Warpine as the SOM compiler's
 * C++ emitter would emit them (ADR-0061).
 */
#ifndef SOM_Hello_xh
#define SOM_Hello_xh

#include <som.xh>

class Hello;

typedef void SOMLINK somTP_Hello_sayHello( Hello *somSelf, Environment *ev );
typedef somTP_Hello_sayHello *somTD_Hello_sayHello;

SOMEXTERN SOMClass * SOMLINK HelloNewClass( integer4 major, integer4 minor );

SOMEXTERN struct HelloClassDataStructure {
    SOMClass *classObject;
    somMToken sayHello;
} SOMDLINK HelloClassData;

#define _Hello  (HelloClassData.classObject ? HelloClassData.classObject : HelloNewClass( 0, 0 ))

class Hello : public SOMObject {
public:
    SOM_CPP_CLASS( Hello )
    void sayHello( Environment *ev ) { SOM_Resolve( this, Hello, sayHello )( this, ev ); }
};

#endif
