/*
 * hello.ih - C implementation bindings of class Hello, written by hand
 * for Warpine as the SOM compiler would emit them (ADR-0059).
 */
#ifndef SOM_Hello_ih
#define SOM_Hello_ih

#include "hello.h"

#define HelloMethodDebug( c, m )  SOM_NoTrace( c, m )

SOM_Scope void SOMLINK sayHello( Hello *somSelf, Environment *ev );

struct HelloClassDataStructure SOMDLINK HelloClassData;

SOMClass * SOMLINK HelloNewClass( integer4 major, integer4 minor )
{
    SOMClass *cls;

    if( HelloClassData.classObject ) return( HelloClassData.classObject );
    SOM_NEW_CLASS( cls, "Hello", SOMObjectClassData.classObject, 0, 1, major, minor );
    HelloClassData.sayHello = SOM_ADD_METHOD( cls, "sayHello", sayHello );
    _somClassReady( cls );
    HelloClassData.classObject = cls;
    return( cls );
}

#endif
