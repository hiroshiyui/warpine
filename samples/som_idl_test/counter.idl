//
// counter.idl - classes for somidl's C bindings (ADR-0122): instance data,
// a class derived from another of the file, an override calling its
// parent's, and initializers / destructors in Warpine's protocol; then
// stage S3: a class with two parents, directinitclasses and an init method;
// stage S4: exceptions raised through the Environment, a union and an any.
#include <somobj.idl>

interface Counter : SOMObject
{
    long add(in long n);
    // Adds n to the total and returns the new total.
    void reset();
    long peek(out long calls);
    // The total; calls gets the number of add calls.

#ifdef __SOMIDL__
    implementation {
        releaseorder: add, reset, peek;
        functionprefix = c_;
        majorversion = 1;
        minorversion = 2;
        long total;
        long calls;
        somDefaultInit: override;
        somDestruct: override;
    };
#endif
};

interface Doubler : Counter
{
    long twice();
    // How many adds were doubled.

#ifdef __SOMIDL__
    implementation {
        releaseorder: twice;
        functionprefix = d_;
        long doubled;
        add: override;
        somDefaultInit: override;
        somDestruct: override;
    };
#endif
};

interface Tagged : SOMObject
{
    long tag();
    // The tag its initializer set.

#ifdef __SOMIDL__
    implementation {
        releaseorder: tag;
        functionprefix = t_;
        long t;
        somDefaultInit: override;
    };
#endif
};

interface Both : Counter, Tagged
{
    void withStart(inout somInitCtrl ctrl, in long start);
    // An initializer: the ancestors' default ones, then start.
    long start();

#ifdef __SOMIDL__
    implementation {
        releaseorder: withStart, start;
        functionprefix = b_;
        directinitclasses = "Tagged, Counter";
        long s;
        withStart: init;
        somDefaultInit: override;
    };
#endif
};

exception TooBig { long limit; };

interface Gauge : SOMObject
{
    exception Negative { long value; };
    union Reading switch (long) {
        case 1: long whole;
        case 2: case 3: double scaled;
        default: string text;
    };

    long set(in long v) raises(TooBig, Negative);
    // The level, unless v is negative or above 100.
    Reading read(in long kind);
    any boxed();

#ifdef __SOMIDL__
    implementation {
        releaseorder: set, read, boxed;
        functionprefix = g_;
        long level;
    };
#endif
};
